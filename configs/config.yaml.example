service:
  management_address: ":2112"
  shutdown_timeout: 15s

postgres:
  url: "${AERO_CONFORMANCE_POSTGRES_URL}"

influx:
  host: "${AERO_CONFORMANCE_INFLUX_HOST}"
  token: "${AERO_CONFORMANCE_INFLUX_TOKEN}"
  database: "${AERO_CONFORMANCE_INFLUX_DATABASE}"
  poll_interval: 1s
  overlap_window: 30s
  settle_delay: 2s
  aircraft_batch_size: 100
  max_rows: 10000

worker:
  id: "${AERO_CONFORMANCE_WORKER_ID}"
  lease_duration: 30s
  renew_interval: 10s
  claim_batch_size: 20

policy:
  version: "standard-v1"
  horizontal_tolerance_m: 5
  vertical_tolerance_m: 3
  open_after_samples: 3
  recover_after_samples: 3
  telemetry_freshness: 15s

logging:
  level: info
  format: json
